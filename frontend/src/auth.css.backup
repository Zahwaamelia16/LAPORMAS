
/* ===================================
   LAPORMAS - LOGIN RESPONSIVE
=================================== */

.auth-page {
  width: 100%;
  height: 100vh;
  height: 100dvh;
  min-height: 0;
  display: grid;
  grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
  overflow: hidden;
}

.auth-page > .auth-visual,
.auth-page > .auth-form-side {
  height: 100%;
  min-height: 0;
  min-width: 0;
  box-sizing: border-box;
}

/* Visual kiri */
.auth-page > .auth-visual {
  overflow: hidden;
  padding: clamp(20px, 3.5vw, 50px);
}

.auth-visual-copy {
  max-width: 570px;
}

.auth-visual-copy h1 {
  font-size: clamp(28px, 4vw, 55px);
}

/* Form kanan */
.auth-page > .auth-form-side {
  display: flex;
  align-items: center;
  justify-content: center;
  overflow-y: auto;
  overscroll-behavior: contain;
  scrollbar-width: none;
  padding: clamp(18px, 3vh, 40px)
           clamp(20px, 3vw, 45px);
}

.auth-form-side::-webkit-scrollbar {
  display: none;
}

.auth-form-wrap {
  width: min(100%, 470px);
  min-width: 0;
  margin: auto;
}

/* Layar laptop pendek */
@media (max-height: 750px) {
  .auth-page > .auth-form-side {
    padding-top: 14px;
    padding-bottom: 14px;
  }

  .auth-form-wrap > .eyebrow {
    margin-top: 15px;
  }

  .auth-form-wrap > p {
    margin-bottom: 18px;
  }

  .role-switch {
    margin-bottom: 18px;
  }

  .form-stack {
    gap: 12px;
  }

  .auth-signup {
    margin-top: 18px;
  }

  .auth-footnote {
    margin-top: 14px;
  }
}

/* Tablet */
@media (max-width: 860px) {
  .auth-page {
    grid-template-columns: minmax(0, 1fr);
    grid-template-rows: minmax(180px, 32dvh) minmax(0, 1fr);
  }

  .auth-page > .auth-visual {
    padding: 18px 28px;
  }

  .auth-visual-copy {
    margin: auto 0;
    padding-bottom: 0;
  }

  .auth-visual-copy h1 {
    font-size: clamp(25px, 5vw, 38px);
  }

  .auth-visual-copy p {
    font-size: 12px;
    line-height: 1.5;
  }

  .auth-page > .auth-form-side {
    padding: 20px 28px;
  }
}

/* HP */
@media (max-width: 560px) {
  .auth-page {
    grid-template-rows: minmax(180px, 27dvh) minmax(0, 1fr);
  }

  .auth-page > .auth-visual {
    padding: 15px 20px;
  }

  .auth-visual-copy h1 {
    font-size: clamp(25px, 7vw, 34px);
    margin-bottom: 8px;
  }

  .auth-visual-copy p {
    font-size: 11px;
    line-height: 1.4;
  }

  .auth-stats {
    gap: 7px;
  }

  .auth-stats > div {
    min-width: 0;
    padding: 9px 7px;
  }

  .auth-stats b {
    font-size: 17px;
  }

  .auth-stats span {
    font-size: 8px;
    line-height: 1.3;
  }

  .auth-page > .auth-form-side {
    padding: 14px 20px;
  }

  .auth-form-wrap {
    width: 100%;
  }

  .auth-form-wrap h2 {
    font-size: 28px;
  }
}

/* HP dengan tinggi layar pendek */
@media (max-width: 560px) and (max-height: 720px) {
  .auth-page {
    grid-template-rows: 125px minmax(0, 1fr);
  }

  .auth-page > .auth-visual {
    padding: 10px 17px;
  }

  .auth-kicker,
  .auth-stats {
    display: none;
  }

  .auth-visual-copy h1 {
    font-size: 23px;
    margin-bottom: 4px;
  }

  .auth-visual-copy p {
    font-size: 10px;
  }

  .auth-page > .auth-form-side {
    padding: 10px 18px;
  }

  .auth-form-wrap > .eyebrow {
    margin-top: 7px;
  }

  .auth-form-wrap > p {
    margin-bottom: 12px;
  }

  .role-switch {
    margin-bottom: 12px;
  }

  .form-stack {
    gap: 9px;
  }

  .auth-signup {
    margin-top: 11px;
  }
}


/* ==========================================
   LAPORMAS - ROLE SWITCH REFINEMENT
========================================== */

.auth-page .role-switch {
  width: 100%;
  height: 58px;
  min-height: 58px;
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  align-items: stretch;
  gap: 5px;

  padding: 5px;
  margin: 0 0 27px;

  background: #eaf1eb;
  border: 1px solid #dce9df;
  border-radius: 14px;

  box-sizing: border-box;
}

.auth-page .role-switch button {
  width: 100%;
  min-width: 0;
  min-height: 0;

  display: flex;
  align-items: center;
  justify-content: center;

  padding: 8px 12px;
  border: 0;
  border-radius: 10px;

  background: transparent;
  color: #587663;

  font-family: 'DM Sans', sans-serif;
  font-size: 13px;
  font-weight: 700;

  white-space: nowrap;
  transition: background .2s ease,
              color .2s ease,
              box-shadow .2s ease;
}

/* Pilihan aktif */
.auth-page .role-switch button.active {
  background: #ffffff;
  color: #17643a;
  box-shadow:
    0 2px 6px rgba(16, 59, 41, .08),
    0 1px 2px rgba(16, 59, 41, .04);
}

/* Hover */
.auth-page .role-switch button:not(.active):hover {
  background: rgba(255, 255, 255, .45);
  color: #17643a;
}

/* Keyboard accessibility */
.auth-page .role-switch button:focus-visible {
  outline: 2px solid #17643a;
  outline-offset: -2px;
}

/* Mobile */
@media (max-width: 560px) {
  .auth-page .role-switch {
    height: 52px;
    min-height: 52px;
    margin-bottom: 20px;
    border-radius: 12px;
  }

  .auth-page .role-switch button {
    font-size: 12px;
    border-radius: 8px;
  }
}
